  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.9.3",
    "wxt": "^0.21.4",
    "playwright": "^1.62.1",
    "ws": "^8.18.0"
  }
