# site build output — generated by site/build.py from site/src/
.vercel
.env*
sdk/rt-check.mjs

# The node endpoint. A public URL pointing at a machine we do not want
# strangers using as their RPC provider, so it stays out of a public repo.
ops/node.env

# Generated by site/build.py from src/agent.html + src/agent-00N.intro.html.
# They live in src/ because everything downstream expects a page there, but a
# diff of three expansions of one template is noise. agent-001.html is NOT
# generated — it has sections no other agent has — so the pattern starts at 2.
site/src/agent-00[2-9].html

# Written by `warda grant`: which manifest, which allowlist and which agent key
# belong together in THIS directory. Machine-local by design — it names a key
# file, and a config that travelled with the repo would point a second machine
# at a grant it does not hold the key for.
.warda/

# Written by ops/first-contact.ts: the baseline of what was already at the
# watched addresses, so only what ARRIVES is news. Machine-local and it changes
# every run.
ops/first-contact.json

# The local usage dashboard, rewritten on every first-contact run.
ops/usage.html
site/src/usage.json
