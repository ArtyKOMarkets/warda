pragma silverscript ^0.1.0;

// Warda — agent grant covenant, v0.1 DRAFT
//
// NOT YET COMPILE-VERIFIED. See PHASE0.md for the constraints that shaped
// this and for the assumptions still to be checked against the compiler.
//
// Immutable authority lives in constructor params, so it is baked into the
// scriptPubKey and cannot move. Mutable accounting lives in contract fields,
// which the compiler synthesises into the implicit `State` struct and binds
// to the successor output via the covenant declaration.

contract WardaGrant(
    pubkey  principalKey,
    pubkey  revocationKey,
    int     maxFee,
    // --- genesis values for the authority fields, which are STATE ---
    byte[32] genesisAgentKey,
    int     genesisBudgetTotal,
    int     genesisMaxPerSpend,
    int     genesisEpochLimit,
    int     genesisEpochLength,
    byte[32] genesisRecipientsRoot,
    int     genesisNotBefore,
    int     genesisExpiresAt,
    int     genesisDelegationDepth,
    // The hash of THIS covenant's own template: blake3 over
    // len(prefix)||prefix||len(suffix)||suffix. It cannot be a constructor
    // constant baked into the prefix or suffix -- the hash would cover itself,
    // which is a preimage fixed point. As STATE it sits between them, where
    // the hash does not reach, and a wrong value simply yields a different
    // address that nobody funded.
    byte[32] genesisTemplateId,
    // Where the state region begins and ends inside the compiled bytecode.
    // readInputStateWithTemplate needs them to slice a foreign redeem script.
    // Baked, and derived from the compiled size, so the deploy tool iterates
    // to a fixed point and asserts it settled.
    int     templatePrefixLen,
    int     templateSuffixLen,
    int     maxProofDepth,
    int     initSpentTotal,
    int     initReserved,
    int     initEpochIndex,
    int     initEpochSpent,
    byte[32] initReserveRoot
) {
    // ---- STATE ----
    // Authority lives here, not in constructor params. A child grant differs
    // from its parent in budget, cap and expiry; if those were ctor params the
    // child would be a DIFFERENT TEMPLATE, and DECL.md is explicit that
    // cross-template routing is not available to declaration lowering. Same
    // template, different state, is the only shape delegation can take.
    //
    // Consequence: `spend` must now assert every authority field is unchanged.
    byte[32] agentKey        = genesisAgentKey;
    int budgetTotal          = genesisBudgetTotal;
    int maxPerSpend          = genesisMaxPerSpend;
    int epochLimit           = genesisEpochLimit;
    int epochLength          = genesisEpochLength;
    byte[32] recipientsRoot  = genesisRecipientsRoot;
    int notBefore            = genesisNotBefore;
    int expiresAt            = genesisExpiresAt;
    int delegationDepth      = genesisDelegationDepth;
    // Authority: fixed for the life of the grant, like every field above.
    byte[32] templateId    = genesisTemplateId;

    int spentTotal = initSpentTotal;
    int reserved   = initReserved;
    int epochIndex = initEpochIndex;
    int epochSpent = initEpochSpent;

    // The LIFO stack of outstanding children, as a hash chain.
    //
    //   delegate:  reserveRoot' = blake2bWithKey(reserveRoot || childId, "WardaReserve")
    //   reabsorb:  supply the previous root and the child; check the hash; pop.
    //
    // A chain rather than a Merkle set, which costs one hash instead of a
    // second fold and needs no proof — at the price of settling children MOST
    // RECENT FIRST. The parent must commit to WHICH children are outstanding:
    // reading a child's state proves it is a real grant of this template, not
    // that it is a grant THIS parent delegated, and releasing reserve for
    // somebody else's child would let a parent over-delegate.
    byte[32] reserveRoot = initReserveRoot;

    // Domain separators MUST be non-zero. Kaspa script encodes the value zero
    // as the EMPTY byte string, so `byte[](0x00)` compiles to nothing and the
    // separator silently disappears — the source reads as domain-separated
    // while the bytecode is not. Caught by opcode tracing, not by review.
    byte constant LEAF = 0x01;
    byte constant NODE = 0x02;

    // Domain-separated Merkle fold. Sibling side travels per-level because
    // odd nodes are promoted without a sibling, so index parity alone cannot
    // reconstruct the order. (This exact bug was caught in @warda/core.)
    function merkleRoot(
        byte[32]   leafValue,
        byte[32][] siblings,
        bool[]     siblingIsLeft
    ) : byte[32] {
        byte[32] node = blake2b(byte[](LEAF) + byte[](leafValue));
        for (i, 0, siblings.length, maxProofDepth) {
            if (siblingIsLeft[i]) {
                node = blake2b(byte[](NODE) + byte[](siblings[i]) + byte[](node));
            } else {
                node = blake2b(byte[](NODE) + byte[](node) + byte[](siblings[i]));
            }
        }
        return node;
    }

    #[covenant.singleton]
    function spend(
        State      prevState,
        State      newState,
        int        amount,
        byte[32]   recipient,
        byte[32][] proofSiblings,
        bool[]     proofSiblingIsLeft,
        int        claimedDaa,
        sig        agentSig
    ) {
        // ------------------------------------------------------------------
        // GUARD ORDER IS NORMATIVE, NOT STYLISTIC.
        //
        // Silverscript integer overflow is UNDEFINED BEHAVIOUR, and the spec
        // is explicit that UB "is not guaranteed to make execution fail" — a
        // contract may simply succeed. So every attacker-supplied integer is
        // bounded BEFORE it reaches any arithmetic. A range check performed
        // after the addition is not a check at all.
        // ------------------------------------------------------------------
        // Authority is immutable across a spend. Without these, an agent
        // rewrites its own cap in the successor and every limit is decorative.
        require(newState.agentKey       == prevState.agentKey);
        require(newState.budgetTotal    == prevState.budgetTotal);
        require(newState.maxPerSpend    == prevState.maxPerSpend);
        require(newState.epochLimit     == prevState.epochLimit);
        require(newState.epochLength    == prevState.epochLength);
        require(newState.recipientsRoot == recipientsRoot);
        require(newState.notBefore      == prevState.notBefore);
        require(newState.expiresAt      == prevState.expiresAt);
        require(newState.delegationDepth == delegationDepth);
        require(newState.templateId   == prevState.templateId);
        // A spend neither creates nor settles a child.
        require(newState.reserveRoot    == prevState.reserveRoot);

        require(amount > 0);
        require(amount <= maxPerSpend);

        // Lower bound only. `tx.daa` is write-only — it emits a CLTV lock and
        // cannot be read as a value — so the agent supplies claimedDaa and the
        // lock proves the chain has actually reached it. Overstating is
        // impossible; understating only costs the agent epoch headroom.
        require(claimedDaa >= notBefore);
        require(tx.daa >= claimedDaa);

        // Budget. The invariant spentTotal + reserved <= budgetTotal is
        // re-asserted rather than assumed, so a malformed prior state cannot
        // drive the subtraction negative.
        int committed = prevState.spentTotal + prevState.reserved;
        require(committed <= budgetTotal);
        require(amount <= budgetTotal - committed);

        require(epochLength > 0);
        int currentEpoch = (claimedDaa - notBefore) / epochLength;

        // THE RATCHET. Without it the per-epoch cap limits nothing.
        //
        // claimedDaa is agent-supplied and bounded BELOW only: `>= notBefore`
        // here, and `tx.daa >= claimedDaa` via CLTV, which any past value
        // satisfies trivially. So an agent whose epoch allowance is exhausted
        // simply claims an EARLIER epoch. The equality test below then finds a
        // mismatch, spentThisEpoch resets to zero, and the whole allowance is
        // available again — as often as the agent likes, bounded only by
        // budgetTotal.
        //
        // Verified against the consensus engine, not reasoned about: with
        // epochIndex 5 and epochSpent == epochLimit, a spend claiming epoch 5
        // is refused (VerifyError) and one claiming epoch 4 is ACCEPTED.
        //
        // Monotonicity is the fix, and it is also what makes expiry
        // enforceable below: an agent that cannot rewind cannot escape an
        // upper bound by pretending to be in the past.
        require(currentEpoch >= prevState.epochIndex);

        // Expiry now BINDS on the spend path. It could not before: CLTV proves
        // only a lower bound on time, so an upper bound on claimedDaa is
        // meaningless on its own — the agent claims an older DAA and walks
        // under it. The ratchet above is what makes this stick.
        //
        // The residual, stated precisely rather than glossed: an agent may
        // position itself at the last pre-expiry epoch with a fresh allowance
        // and spend up to ONE epochLimit after expiresAt has passed. That is
        // the floor for this mechanism, because no covenant can prove the
        // chain is BEFORE a given time. Size epochLimit accordingly — it is
        // the exact bound on post-expiry exposure.
        require(claimedDaa < expiresAt);

        int spentThisEpoch = 0;
        if (currentEpoch == prevState.epochIndex) {
            spentThisEpoch = prevState.epochSpent;
        }
        require(spentThisEpoch <= epochLimit);
        require(amount <= epochLimit - spentThisEpoch);

        require(merkleRoot(recipient, proofSiblings, proofSiblingIsLeft) == recipientsRoot);

        // Successor state. Without these four lines every limit above is
        // decorative — an agent that can rewrite its own remaining budget
        // has no budget.
        require(newState.spentTotal == prevState.spentTotal + amount);
        require(newState.reserved   == prevState.reserved);
        require(newState.epochIndex == currentEpoch);
        require(newState.epochSpent == spentThisEpoch + amount);

        // Output topology. The continuation's real index comes from
        // OpAuthOutputIdx — it is NOT guaranteed to be output 0, and assuming
        // so was a bug in the first draft of this file. We pin the topology
        // instead of scanning: continuation at 0, payment at 1. Cheaper than a
        // search, and the SDK builds every spend this way.
        //
        // The count check is belt-and-braces: the generated singleton wrapper
        // already rejects two authorised outputs from one input (see
        // covenant_declaration_security_tests.rs). Keeping it explicit costs
        // little and documents the assumption at the point it is relied on.
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        require(OpAuthOutputIdx(this.activeInputIndex, 0) == 0);

        byte[34] payTo = new ScriptPubKeyP2PK(pubkey(recipient));
        require(tx.outputs[1].scriptPubKey == byte[](payTo));
        require(tx.outputs[1].value == amount);

        // Value conservation: the continuation keeps everything except the
        // payment and a bounded fee. Without the maxFee bound an agent burns
        // the grant to fees instead of spending it.
        int inValue = tx.inputs[this.activeInputIndex].value;
        require(inValue >= amount);
        require(tx.outputs[0].value >= inValue - amount - maxFee);

        require(checkSig(agentSig, pubkey(agentKey)));
    }



    // ------------------------------------------------------------------
    // DELEGATION — 1:2 fanout. Parent continuation at auth output 0, child
    // grant at auth output 1.
    //
    // Conservation is the whole point: authority is neither created nor
    // destroyed here, only subdivided. The parent RESERVES exactly what the
    // child receives, and real KAS moves with it — a child that held authority
    // but no coins could not pay anyone, and a child that held coins but no
    // reserve against the parent would double the tree's total authority.
    // ------------------------------------------------------------------
    #[covenant.fanout(to = 2)]
    function delegate(State prevState, State[] newStates, sig agentSig) {
        State parentNext = newStates[0];
        State child      = newStates[1];

        // Bound the attacker-controlled figure BEFORE any arithmetic. Overflow
        // is undefined behaviour in Silverscript and UB may SUCCEED, so a
        // range check after the addition is not a check at all.
        require(child.budgetTotal > 0);
        int committed = spentTotal + reserved;
        require(committed <= budgetTotal);
        require(child.budgetTotal <= budgetTotal - committed);

        // ---- attenuation: a child may only ever be narrower ----
        require(child.maxPerSpend     <= maxPerSpend);
        require(child.epochLimit      <= epochLimit);
        require(child.epochLength     == epochLength);
        require(child.notBefore       >= notBefore);
        require(child.expiresAt       <= expiresAt);
        require(child.delegationDepth <  delegationDepth);

        // Inherit mode. Set inclusion is not decidable from a Merkle root, so
        // the only allowlist relation enforceable on roots alone is equality.
        // Narrowing needs per-member inclusion proofs — see @warda/core's
        // subset witness; not in this covenant yet.
        require(child.recipientsRoot == recipientsRoot);

        // A child starts spent-out-of-nothing. Without this it could be born
        // mid-epoch with a used allowance, or worse, with a negative one.
        require(child.spentTotal == 0);
        require(child.reserved   == 0);
        require(child.epochIndex == 0);
        require(child.epochSpent == 0);
        // Same covenant, so the same template hash. Without this a child could
        // be born claiming a different template and would never match at
        // settlement — its reserve would be stuck forever.
        require(child.templateId == templateId);
        // A newborn child has delegated to nobody.
        byte[32] emptyStack = blake2b(byte[]("WardaEmptyReserve"));
        require(child.reserveRoot == emptyStack);

        // ---- the parent only reserves; nothing else about it may move ----
        require(parentNext.agentKey        == agentKey);
        require(parentNext.budgetTotal     == budgetTotal);
        require(parentNext.maxPerSpend     == maxPerSpend);
        require(parentNext.epochLimit      == epochLimit);
        require(parentNext.epochLength     == epochLength);
        require(parentNext.recipientsRoot  == recipientsRoot);
        require(parentNext.notBefore       == notBefore);
        require(parentNext.expiresAt       == expiresAt);
        require(parentNext.delegationDepth == delegationDepth);
        require(parentNext.spentTotal      == spentTotal);
        require(parentNext.epochIndex      == epochIndex);
        require(parentNext.epochSpent      == epochSpent);
        require(parentNext.reserved        == reserved + child.budgetTotal);
        require(parentNext.templateId    == templateId);
        // Push. The parent now owes this specific child, and can only release
        // the reserve by producing it.
        // A child's IDENTITY: the fields that can never change once it exists.
        // Deliberately excludes spentTotal / reserved / epochIndex / epochSpent,
        // which move as the child spends — an identity that changed with use
        // could not be matched at settlement, which is the whole point of it.
        //
        // OpNum2Bin gives a FIXED eight bytes. Script's native integer form is
        // minimal-width, so 1 and 256 occupy different numbers of bytes and two
        // different children could collide by shifting a field boundary.
        byte[32] cid = blake2bWithKey(
            byte[](child.agentKey)
                + OpNum2Bin(child.budgetTotal, 8)
                + OpNum2Bin(child.maxPerSpend, 8)
                + OpNum2Bin(child.epochLimit, 8)
                + OpNum2Bin(child.epochLength, 8)
                + byte[](child.recipientsRoot)
                + OpNum2Bin(child.notBefore, 8)
                + OpNum2Bin(child.expiresAt, 8)
                + OpNum2Bin(child.delegationDepth, 8),
            byte[]("WardaChildId")
        );
        byte[32] pushed = blake2bWithKey(byte[](reserveRoot) + byte[](cid), byte[]("WardaReserve"));
        require(parentNext.reserveRoot == pushed);

        // ---- value follows authority ----
        require(OpAuthOutputCount(this.activeInputIndex) == 2);
        require(OpAuthOutputIdx(this.activeInputIndex, 0) == 0);
        require(OpAuthOutputIdx(this.activeInputIndex, 1) == 1);

        int inValue = tx.inputs[this.activeInputIndex].value;
        require(inValue >= child.budgetTotal);
        require(tx.outputs[1].value == child.budgetTotal);
        require(tx.outputs[0].value >= inValue - child.budgetTotal - maxFee);

        require(checkSig(agentSig, pubkey(agentKey)));
    }


    // ------------------------------------------------------------------
    // REABSORB — a settled child returns its remainder, and the parent's
    // reserve is released.
    //
    // Without this, `reserved` only ever grows: a parent could delegate its
    // budget exactly once across its whole life, and reclaiming a child gave
    // the coin back to the principal while leaving the parent's capacity
    // permanently consumed. Lanes could be built and never recycled.
    //
    // Two things have to be true at once, and each needs a different
    // mechanism:
    //
    //   the child is REAL       readInputStateWithTemplate proves input
    //                           `childIdx` carries a genuine grant of this
    //                           template and decodes its actual state. That is
    //                           what lets the parent charge the child's REAL
    //                           spentTotal rather than a number the agent
    //                           supplies.
    //
    //   the child is OURS       the hash chain. Reading a child's state does
    //                           not prove this parent delegated it, and
    //                           releasing reserve for a sibling's child would
    //                           let a parent over-delegate — creating
    //                           authority out of nothing.
    // ------------------------------------------------------------------
    #[covenant.fanout(to = 1)]
    function reabsorb(State prevState, State[] newStates, int childIdx, byte[32] prevRoot, sig agentSig) {
        State newState = newStates[0];
        require(childIdx >= 0);
        require(childIdx < tx.inputs.length);
        require(childIdx != this.activeInputIndex);

        State child = readInputStateWithTemplate(childIdx, templatePrefixLen, templateSuffixLen, templateId);

        // Pop, and prove the pop. The identity is rebuilt from the child's
        // CURRENT state using only its immutable fields, so a child that has
        // been spending still matches what the parent committed to.
        //
        // Duplicated from delegate rather than shared: a user function returns
        // a tuple here, which neither assigns to byte[32] nor compares against
        // one. Both copies must move together, and the probe corpus is what
        // notices if they do not.
        byte[32] cid = blake2bWithKey(
            byte[](child.agentKey)
                + OpNum2Bin(child.budgetTotal, 8)
                + OpNum2Bin(child.maxPerSpend, 8)
                + OpNum2Bin(child.epochLimit, 8)
                + OpNum2Bin(child.epochLength, 8)
                + byte[](child.recipientsRoot)
                + OpNum2Bin(child.notBefore, 8)
                + OpNum2Bin(child.expiresAt, 8)
                + OpNum2Bin(child.delegationDepth, 8),
            byte[]("WardaChildId")
        );
        byte[32] pushed = blake2bWithKey(byte[](prevRoot) + byte[](cid), byte[]("WardaReserve"));
        require(reserveRoot == pushed);
        require(newState.reserveRoot == prevRoot);

        // The child's real spending becomes the parent's. Releasing the
        // reserve without charging what the child spent would let the same
        // authority be issued twice.
        require(child.spentTotal >= 0);
        require(child.budgetTotal > 0);
        require(reserved >= child.budgetTotal);
        require(newState.reserved   == reserved - child.budgetTotal);
        require(newState.spentTotal == spentTotal + child.spentTotal);
        require(newState.spentTotal + newState.reserved <= budgetTotal);

        // Everything else about the parent stands still.
        require(newState.agentKey        == agentKey);
        require(newState.budgetTotal     == budgetTotal);
        require(newState.maxPerSpend     == maxPerSpend);
        require(newState.epochLimit      == epochLimit);
        require(newState.epochLength     == epochLength);
        require(newState.recipientsRoot  == recipientsRoot);
        require(newState.notBefore       == notBefore);
        require(newState.expiresAt       == expiresAt);
        require(newState.delegationDepth == delegationDepth);
        require(newState.templateId    == templateId);
        require(newState.epochIndex      == epochIndex);
        require(newState.epochSpent      == epochSpent);

        // One continuation, and the coin from BOTH inputs lands in it.
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        require(OpAuthOutputIdx(this.activeInputIndex, 0) == 0);
        int combined = tx.inputs[this.activeInputIndex].value + tx.inputs[childIdx].value;
        require(tx.outputs[0].value >= combined - maxFee);

        require(checkSig(agentSig, pubkey(agentKey)));
    }

    // ------------------------------------------------------------------
    // SETTLE — the child's half of a reabsorb.
    //
    // Signed by the REVOCATION key, not the child's agent. A cooperative-only
    // settlement would let an unresponsive child lock its parent's budget
    // forever, which is the failure this whole path exists to remove. The
    // revocation key can already end a child outright via `revoke`, so this
    // grants it nothing new — it only changes where the coin goes: back to the
    // parent rather than out to the principal.
    //
    // The value check is what stops this being a way to move a child's coin
    // anywhere at all. Paired with the parent's own conservation check above,
    // the two inputs are fully accounted for.
    // ------------------------------------------------------------------
    entry settle(sig s) {
        require(checkSig(s, revocationKey));
        int combined = tx.inputs[0].value + tx.inputs[1].value;
        require(tx.outputs[0].value >= combined - maxFee);
    }

    // Revocation: the principal pulls the funds back. This does not race-proof
    // an in-flight agent spend — it makes the remaining balance unreachable
    // from the next block on. See PHASE0.md.
    entry revoke(sig s) {
        require(checkSig(s, revocationKey));
        byte[34] toPrincipal = new ScriptPubKeyP2PK(principalKey);
        require(tx.outputs[0].scriptPubKey == byte[](toPrincipal));

        // Value conservation, which this path did not have. Without it revoke
        // constrains only WHERE the coin goes, never how much: a revoke paying
        // 1 sompi to the principal and burning the rest to fees was accepted by
        // the engine. So the revocation key was a DESTROY capability, not a
        // STOP capability — and the whole reason the field is separate from
        // principalKey is to let a monitor stop a grant without being trusted
        // with its balance. A monitor that cannot take the money but can burn
        // it is not meaningfully less dangerous.
        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value - maxFee);
    }

    // Expiry is a RECLAIM RIGHT, not a spend prohibition. A UTXO covenant
    // cannot express "must be spent before X" — CLTV only expresses "not
    // before". After expiresAt the principal can sweep; until they do, the
    // agent's spend path still works.
    entry reclaim(sig s) {
        require(tx.daa >= expiresAt);
        require(checkSig(s, principalKey));
        byte[34] toPrincipal = new ScriptPubKeyP2PK(principalKey);
        require(tx.outputs[0].scriptPubKey == byte[](toPrincipal));

        // Same clause as revoke. Less urgent here — reclaim needs the
        // principal's own key, and a principal burning their own money is
        // their business — but an exit path that silently tolerates the loss
        // of the entire balance is a bad thing to have lying around, and the
        // asymmetry between the two paths would itself be a trap.
        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value - maxFee);
    }
}
