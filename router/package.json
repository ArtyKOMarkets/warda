{
  "name": "@warda_protocol/router",
  "version": "0.1.0",
  "description": "Turning a price into an amount an agent can pay, and saying which parts of the answer consensus enforced and which parts somebody asserted.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../ops/check-releasable.mjs --for router && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@warda_protocol/core": "^0.3.1",
    "@warda_protocol/kaspa": "^0.6.0"
  }
}
