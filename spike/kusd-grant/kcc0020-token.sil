pragma silverscript ^0.1.0;

// A KCC20 token in the DRAFT KCC-0020 shape, for comparison with the
// silverscript example that KUSD ships (tests/examples/kusd-kcc20.sil).
//
// It is not a competing implementation and nothing is deployed from it. It
// exists so a Warda grant can be tested against BOTH state layouts, because
// the two disagree about more than a name:
//
//   silverscript / KUSD            draft KCC-0020
//   -------------------            --------------
//   ownerIdentifier byte[32]       amount            int
//   identifierType  byte           owner             byte[32]
//   amount          int            ownerScheme       byte
//   isMinter        bool           borrowScheme      byte
//                                  borrowGuard       byte[32]
//                                  extensionCommitment byte[32]
//
//   0x00 pubkey                    0x00 p2pk-schnorr
//   0x01 script hash               0x01 p2pkh-schnorr
//   0x02 COVENANT ID               0x02 p2pkh-ecdsa
//                                  0x03 p2sh
//                                  0x04 COVENANT ID
//
// The dangerous line is the third one. 0x02 is a valid scheme in both and
// means different things: "owned by a covenant" in one, "owned by an ECDSA
// key hash" in the other. A reader that knows only one of the two tables
// cannot tell it is looking at the wrong one.
//
// Minting is deliberately absent: the draft's state has no isMinter field and
// the grant under test never mints. Conservation is all these tests need.
contract KCC0020(
    int genesisAmount,
    byte[32] genesisOwner,
    byte genesisOwnerScheme,
    byte genesisBorrowScheme,
    byte[32] genesisBorrowGuard,
    byte[32] genesisExtensionCommitment,
    int maxCovIns,
    int maxCovOuts
) {
    byte constant SCHEME_P2PK = 0x00;
    byte constant SCHEME_P2SH = 0x03;
    byte constant SCHEME_COVENANT_ID = 0x04;

    int amount = genesisAmount;
    byte[32] owner = genesisOwner;
    byte ownerScheme = genesisOwnerScheme;
    byte borrowScheme = genesisBorrowScheme;
    byte[32] borrowGuard = genesisBorrowGuard;
    byte[32] extensionCommitment = genesisExtensionCommitment;

    function checkInputSig(sig s, byte witness) {
        if(ownerScheme == SCHEME_P2PK){
            require(checkSig(s, pubkey(owner)));
        } else if(ownerScheme == SCHEME_P2SH){
            byte[] spk = byte[](new ScriptPubKeyP2SH(owner));
            require(tx.inputs[unsigned(witness)].scriptPubKey == spk);
        } else if(ownerScheme == SCHEME_COVENANT_ID){
            require(OpCovInputCount(owner) > 0);
        } else { require(false); }
    }

    function checkAmounts(State[] prevStates, State[] newStates) {
        int totalIn = 0;
        for(i, 0, prevStates.length, maxCovIns) { totalIn = totalIn + prevStates[i].amount; }
        int totalOut = 0;
        for(i, 0, newStates.length, maxCovOuts) { totalOut = totalOut + newStates[i].amount; }
        require(totalIn == totalOut);
    }

    #[covenant(binding = cov, from = maxCovIns, to = maxCovOuts, name = transfer, delegate_name = transfer_delegator)]
    function transferPolicy(State[] prevStates, State[] newStates, sig s, byte witness) {
        checkInputSig(s, witness);
        checkAmounts(prevStates, newStates);
    }

    #[covenant.delegate]
    function authorizeDelegate(sig s, byte witness) { checkInputSig(s, witness); }
}
