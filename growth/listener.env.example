# Copy to growth/listener.env, which is gitignored, and fill in.
#
# X_BEARER_TOKEN is billed per post read — $0.005 each, against your card.
# Treat it as a password, not a setting. Get it from console.x.com; it is
# shown once, and regenerating invalidates the old one.
X_BEARER_TOKEN=

# Signs the X-reads quotes. Generate once and keep it: a value that changes
# between restarts makes every quote issued before the restart unverifiable
# after it, and a buyer who paid against one is refused having paid.
#
#     openssl rand -hex 32
QUOTE_SECRET=

# The Listener's Telegram. Without these a pass prints to the terminal instead.
WARDA_TELEGRAM_TOKEN=
WARDA_TELEGRAM_CHAT=

# Handles never worth reporting: yours, and anyone already in a thread with you.
LISTENER_MUTE=wardaprotocol

# The topics checked on every pass rather than on the rotation.
LISTENER_ALWAYS=x402,agent payments
