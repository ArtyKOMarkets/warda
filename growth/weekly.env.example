# Copy to growth/weekly.env (gitignored) to change the week's defaults.

# The key that funds each batch grant, and can end it. Its LARGEST coin must
# hold the batch (about 0.9 KAS for 12 records): genesis takes one input.
# export GROWTH_FUNDER_KEY="$HOME/Desktop/warda/growth/keys/growth.key"

# Records a week. Each is one payment of 0.05 KAS.
# export GROWTH_RECORDS=12

# Where Researcher is hosted (growth/deploy).
# export GROWTH_RESEARCHER_URL="https://warda-growth.vercel.app"

# Optional: a GitHub token (no scopes needed) raises the search rate limit.
# export GITHUB_TOKEN=""
