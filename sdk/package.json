{
  "name": "@warda_protocol/kaspa",
  "version": "0.4.0",
  "description": "Build, sign and verify Warda agent grants on Kaspa L1 covenants. Derives grant addresses and assembles covenant transactions with no Silverscript compiler and no Rust toolchain.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./covenant-template.json": "./covenant-template.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "covenant-template.json",
    "covenant-template-v1.json",
    "covenant-template-v2.json",
    "covenant-template-v3.json",
    "golden-spend.json",
    "golden-genesis.json",
    "golden-delegation.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build:golden": "node --experimental-strip-types tools/build-spend.ts --golden",
    "build:genesis": "node --experimental-strip-types tools/build-spend.ts --genesis",
    "build:live": "node --experimental-strip-types tools/build-spend.ts --live",
    "build:delegate": "node --experimental-strip-types tools/build-spend.ts --delegate",
    "verify:grant": "node --experimental-strip-types tools/verify-grant.ts",
    "capture:rpc": "node --experimental-strip-types tools/capture-rpc.ts",
    "build:reclaim": "node --experimental-strip-types tools/build-exit.ts --reclaim",
    "build:revoke": "node --experimental-strip-types tools/build-exit.ts --revoke",
    "build:delegation": "node --experimental-strip-types tools/build-delegation.ts",
    "build:live-spend": "node --experimental-strip-types tools/build-live-spend.ts",
    "advance": "node --experimental-strip-types tools/advance-manifest.ts",
    "genesis": "node --experimental-strip-types tools/genesis.ts",
    "probes": "node --experimental-strip-types tools/probes.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "kaspa",
    "covenant",
    "agent",
    "payments",
    "warda",
    "x402",
    "agent-payments",
    "spending-limits"
  ],
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtyKOMarkets/warda.git",
    "directory": "sdk"
  },
  "homepage": "https://wardaprotocol.com",
  "bugs": {
    "url": "https://github.com/ArtyKOMarkets/warda/issues"
  },
  "sideEffects": false
}
