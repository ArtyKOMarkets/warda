{
  "name": "@warda/kaspa",
  "version": "0.2.0",
  "description": "Build and sign Warda agent spends on Kaspa. Derives grant addresses and assembles covenant transactions with no Silverscript compiler.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "covenant-template.json",
    "golden-spend.json",
    "golden-genesis.json",
    "golden-delegation.json",
    "README.md",
    "tools"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build:golden": "node --experimental-strip-types tools/build-spend.ts --golden",
    "build:genesis": "node --experimental-strip-types tools/build-spend.ts --genesis",
    "build:live": "node --experimental-strip-types tools/build-spend.ts --live",
    "build:delegate": "node --experimental-strip-types tools/build-spend.ts --delegate",
    "verify:grant": "node --experimental-strip-types tools/verify-grant.ts",
    "capture:rpc": "node --experimental-strip-types tools/capture-rpc.ts",
    "build:reclaim": "node --experimental-strip-types tools/build-exit.ts --reclaim",
    "build:revoke": "node --experimental-strip-types tools/build-exit.ts --revoke",
    "build:delegation": "node --experimental-strip-types tools/build-delegation.ts"
  },
  "keywords": [
    "kaspa",
    "covenant",
    "agent",
    "payments",
    "warda"
  ],
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "@noble/curves": "^2.3.0"
  }
}
