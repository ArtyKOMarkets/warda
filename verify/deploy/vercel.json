{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/verify.ts": {
      "maxDuration": 30,
      "includeFiles": "{node_modules/@kluster/kaspa-wasm/**,api/covenant-template.json}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/verify"
    }
  ]
}
