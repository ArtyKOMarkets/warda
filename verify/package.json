{
  "name": "@warda_protocol/verify",
  "version": "0.1.0",
  "description": "An HTTP endpoint that answers a counterparty's question about a Warda grant: are these terms real, where did the grant go, and what would the covenant refuse right now. Reads a node, decides nothing.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "warda-verify": "dist/serve.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "serve": "node --experimental-strip-types tools/serve.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@warda_protocol/core": "^0.3.1",
    "@warda_protocol/kaspa": "^0.5.0",
    "@warda_protocol/x402": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  },
  "keywords": [
    "kaspa",
    "warda",
    "verification",
    "agent",
    "spending-limits",
    "covenant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtyKOMarkets/warda.git",
    "directory": "verify"
  },
  "homepage": "https://wardaprotocol.com",
  "bugs": {
    "url": "https://github.com/ArtyKOMarkets/warda/issues"
  },
  "sideEffects": false
}
