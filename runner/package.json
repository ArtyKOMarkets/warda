  "license": "MIT",
  "main": "./src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@turnkey/sdk-server": "^8.5.1",
    "@warda_protocol/agent": "^0.1.0",
    "@warda_protocol/core": "^0.3.1",
    "@warda_protocol/kaspa": "^0.6.0",
    "@warda_protocol/x402": "^0.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
