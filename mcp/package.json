{
  "name": "@warda_protocol/mcp",
  "version": "0.4.1",
  "description": "MCP server exposing a Warda grant's whole life to agent frameworks: authority, spends, delegation, settlement, revocation and recovery. Builds unsigned transactions and explains verdicts; never holds a key, never enforces — the covenant does that on-chain.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "warda-mcp": "dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm test && npm run build",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.0",
    "@noble/hashes": "^2.3.0",
    "@noble/curves": "^2.3.0",
    "@warda_protocol/kaspa": "^0.3.0",
    "@warda_protocol/core": "^0.3.0"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtyKOMarkets/warda.git",
    "directory": "mcp"
  },
  "homepage": "https://wardaprotocol.com",
  "bugs": {
    "url": "https://github.com/ArtyKOMarkets/warda/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kaspa",
    "agent",
    "warda",
    "spending-limits"
  ]
}
