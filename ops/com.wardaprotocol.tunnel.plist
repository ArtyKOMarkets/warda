<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keeps the named tunnel running, on the same terms as the node above.

  Replace warda-node if you named the tunnel something else. The path below
  is where README.md's install puts the binary; if you installed it some other
  way, `command -v cloudflared` says where. launchd does not read your shell
  profile, so this must be an absolute path either way — a LaunchAgent with a
  bare command name fails silently and shows up only as a service that never
  starts.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wardaprotocol.tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/artautasjasinskas/.local/bin/cloudflared</string>
    <string>tunnel</string>
    <string>run</string>
    <string>warda-node</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/artautasjasinskas/Library/Logs/warda-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/artautasjasinskas/Library/Logs/warda-tunnel.log</string>
</dict>
</plist>
