# Copy to ops/node.env and fill in your own endpoint. That copy is gitignored.
#
# Point this at the node as THIS MACHINE reaches it. Everything in ops/ runs
# beside the node, so that is nearly always localhost:
#
#     export WARDA_RPC_JSON="ws://127.0.0.1:18210"
#
# It is worth being emphatic about, because the alternative failed quietly for
# two days. The hourly reading was pointed at the machine's public Tailscale
# hostname — correct-looking, and it worked until a reboot took the tunnel down
# without taking the node down. Every reading after that failed, the agent page
# went on publishing the last good one as though it were current, and nothing
# said otherwise. A local process reaching its own node through a public tunnel
# has taken a dependency it did not need.
#
# The tunnel hostname belongs wherever an OUTSIDE caller is configured, not
# here. Note the JSON wRPC port differs from the Borsh one: testnet is 18210
# and 17210, and the JSON port only listens if kaspad was started with
# --rpclisten-json=<host:port>.
export WARDA_RPC_JSON="ws://127.0.0.1:18210"
export WARDA_NETWORK="testnet-10"
