{
  "name": "@warda_protocol/cli",
  "version": "0.1.0",
  "description": "One short command for the whole life of a Warda grant: create it, see what it may spend, pay behind an HTTP 402, and read back every attempt. Adds no capability \u2014 the rules stay in @warda_protocol/core.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "warda": "./dist/warda.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "kaspa",
    "warda",
    "agent",
    "x402",
    "cli",
    "agent-payments",
    "spending-limits"
  ],
  "dependencies": {
    "@warda_protocol/mcp": "^0.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtyKOMarkets/warda.git",
    "directory": "cli"
  },
  "homepage": "https://wardaprotocol.com",
  "bugs": {
    "url": "https://github.com/ArtyKOMarkets/warda/issues"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs && node dist/warda.js --version"
  }
}
