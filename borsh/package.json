{
  "name": "@warda_protocol/borsh",
  "version": "0.4.1",
  "description": "Kaspa over borsh wRPC \u2014 the encoding the public resolvers actually serve. Reads the UTXO set, and submits covenant-carrying transactions through a build that has them, so neither side of a Warda payment needs a node.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tools",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../ops/check-releasable.mjs --for borsh && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@warda_protocol/kaspa": "^0.6.0"
  },
  "peerDependencies": {
    "@kluster/kaspa-wasm": "*",
    "kaspa-wasm32-sdk": "*"
  },
  "peerDependenciesMeta": {
    "@kluster/kaspa-wasm": {
      "optional": true
    },
    "kaspa-wasm32-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  },
  "keywords": [
    "kaspa",
    "borsh",
    "wrpc",
    "resolver",
    "utxo",
    "covenant",
    "agent-payments"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtyKOMarkets/warda.git",
    "directory": "borsh"
  },
  "homepage": "https://wardaprotocol.com",
  "bugs": {
    "url": "https://github.com/ArtyKOMarkets/warda/issues"
  },
  "sideEffects": false
}
